{
  "manifest_version": 3,
  "name": "Core (Android)",
  "version": "1.2.0",
  "description": "Android build: Tor-style canvas protection, WebGL spoofing, UTC timezone, en-US language, plus battery, sensors, network info and device-model hint protection.",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequest", "privacy", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Core Android: tap to allow canvas reads on this site"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js", "mobile.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
